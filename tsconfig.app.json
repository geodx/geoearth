{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": false, //数组访问不变成undefined
    "exactOptionalPropertyTypes": false, //可选属性不会过度严格
    "skipLibCheck": true, //跳过node_modules类型检查
    "useUnknownInCatchVariables": false //catch语句中的变量类型为unknown
    // "noImplicitAny": false //允许隐式any类型
  }
}
